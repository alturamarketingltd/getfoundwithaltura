  "narrative": {
    "northStar": "The Clinic Front Desk",
    "overview": "Get Found should feel like walking up to the front desk of a well-run practice: calm, friendly, professional, and easy to book. Two grounds carry the page: deep Klein blue for the confident chapters and warm linen for reading and deciding. Yellow is the single bright signal. Components lean warm and tactile.",
    "keyCharacteristics": [
      "Two grounds, Klein blue and linen, with a long blue chapter rather than strict alternation.",
      "One typeface (Hanken Grotesk) for everything, with hierarchy from weight and size.",
      "Yellow used sparingly, as a signal, never as decoration.",
      "Soft, rounded, touchable components with gentle depth.",
      "Plain-language copy; no labels above headings, no section numbers."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "Yellow marks what to press or the single thing to notice. At most one yellow element per view besides the logo dot; never yellow icons, rules, badges or underlines.",
        "section": "colors"
      },
      {
        "name": "The Never-on-Linen Rule",
        "body": "Yellow is never text on linen or chalk (about 1:1). On light grounds it may only sit behind Klein Blue text, and even that is rare.",
        "section": "colors"
      },
      {
        "name": "The Heading Speaks Rule",
        "body": "No small uppercase labels above headings and no 01/02/03 section numbers. If a word matters, it belongs in the heading or the body.",
        "section": "typography"
      },
      {
        "name": "The Soft Lift Rule",
        "body": "Depth is always soft and offset-free in feel: large blur, low opacity. Never hard offset shadows or coloured glows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep each section to one main button.",
      "Do use Mist for secondary text on blue and Slate on linen.",
      "Do keep corners soft (24px cards, pill buttons) and depth gentle.",
      "Do keep Hanken Grotesk for everything."
    ],
    "donts": [
      "Don't use yellow for icons, rules, badges, numerals or highlighter underlines.",
      "Don't put a small uppercase label or number above a heading.",
      "Don't use slashed-zero or overly technical fonts.",
      "Don't use hard offset shadows or coloured glows."
    ]
  }
}