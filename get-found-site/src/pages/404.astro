---
import Layout from '../layouts/Layout.astro';
import { site } from '../content/site';
---

<Layout title={`Page not found | ${site.name}`} description="This page could not be found.">
  <section class="section on-light bg-paper text-ink">
    <div class="wrap">
      <h1 class="text-5xl font-bold tracking-tight">Page not found</h1>
      <p class="mt-4 text-lg text-slate">
        That page does not exist. <a href="/" class="font-semibold text-ink underline underline-offset-4">Go to the home page</a>.
      </p>
    </div>
  </section>
</Layout>
