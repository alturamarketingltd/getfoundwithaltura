---
/**
 * /check: landing page for the free visibility check, for links from social posts.
 * One job: get the form filled in. No menu, no pricing.
 */
import Layout from '../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import Scorecard from '../components/Scorecard.astro';
import { checkPage as p, why, SCORECARD_FORM_ENDPOINT } from '../content/site';
import founderPhoto from '../assets/founder.jpg';
import example from '../assets/scorecard-example.png';

const showScorecard = Boolean(SCORECARD_FORM_ENDPOINT) || import.meta.env.DEV;
const f = why.founder;
---

<Layout title={p.title} description={p.description} minimal>
  <!-- 1. Promise and form -->
  <section class="on-dark bg-ink text-paper">
    <div class="wrap grid items-start gap-10 pb-16 pt-6 md:pb-24 md:pt-10 lg:grid-cols-[1fr_1.05fr] lg:gap-14">
      <div class="lg:pt-6">
        <h1 class="text-[2.25rem] font-extrabold leading-[1.05] tracking-[-0.03em] sm:text-[3.25rem]">
          {p.headlineBefore}<span class="text-sun">{p.headlineHighlight}</span>{p.headlineAfter}
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-mist sm:text-xl">{p.subhead}</p>
        <ul class="mt-8 hidden max-w-md gap-3 text-base font-semibold lg:grid">
          {
            p.includes.items.slice(0, 3).map((item) => (
              <li class="flex items-start gap-3">
                <svg viewBox="0 0 24 24" class="mt-0.5 h-5 w-5 shrink-0 text-sun" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M8 12.3l2.7 2.7L16 9.5" /></svg>
                {item.title}
              </li>
            ))
          }
        </ul>
      </div>
      <div id="check" class="scroll-mt-6">
        <h2 class="sr-only">{p.formHeading}</h2>
        {showScorecard && <Scorecard source="check page" />}
      </div>
    </div>
  </section>

  <!-- 2. What's in it, with an example -->
  <section class="section on-light bg-paper text-ink" aria-labelledby="includes-h">
    <div class="wrap grid items-start gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <div>
        <h2 id="includes-h" class="h2">{p.includes.heading}</h2>
        <ol class="mt-10 grid gap-x-8 gap-y-7 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
          {
            p.includes.items.map((item) => (
              <li class="border-t-2 border-ink pt-4">
                <h3 class="text-xl font-bold">{item.title}</h3>
                <p class="mt-2 text-base leading-relaxed text-slate">{item.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
      <figure class="lg:sticky lg:top-8">
        <p class="mb-3"><span class="rounded-full bg-sun px-3 py-1 text-sm font-bold text-ink">{p.includes.exampleLabel}</span></p>
        <div class="overflow-hidden rounded-2xl shadow-xl ring-1 ring-paper-2">
          <!-- The page has empty space at the bottom; show it down to the last card. -->
          <div class="aspect-[1632/1720]">
            <Picture
              src={example}
              alt={p.includes.exampleAlt}
              widths={[480, 720, 1000, 1400]}
              sizes="(min-width: 1024px) 34rem, 100vw"
              formats={['avif', 'webp']}
              class="h-full w-full object-cover object-top"
              loading="lazy"
            />
          </div>
        </div>
        <figcaption class="mt-4 text-sm text-slate">
          {p.includes.exampleCaption}{' '}
          <a href="/scorecard-example.pdf" class="font-semibold text-ink underline underline-offset-4" data-event="example_pdf_click" data-location="check-example">{p.includes.examplePdf}</a>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 3. What happens next, and who does it -->
  <section class="section on-dark bg-ink text-paper" aria-labelledby="steps-h">
    <div class="wrap">
      <h2 id="steps-h" class="h2">{p.steps.heading}</h2>
      <ol class="mt-10 grid gap-8 md:grid-cols-3">
        {
          p.steps.items.map((step, i) => (
            <li class="rounded-2xl bg-ink-2 p-6">
              <span class="grid h-9 w-9 place-items-center rounded-full bg-sun text-base font-extrabold text-ink" aria-hidden="true">{i + 1}</span>
              <h3 class="mt-4 text-xl font-bold">{step.title}</h3>
              <p class="mt-2 leading-relaxed text-mist">{step.body}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-14 flex flex-col gap-6 border-t border-ink-3 pt-10 sm:flex-row sm:items-center">
        <Picture
          src={founderPhoto}
          alt={f.photoAlt}
          widths={[160, 320]}
          sizes="160px"
          formats={['avif', 'webp']}
          class="h-40 w-32 shrink-0 rounded-2xl object-cover"
          loading="lazy"
        />
        <div class="max-w-2xl">
          <p class="text-lg leading-relaxed text-paper">{f.bio[0]}</p>
          <p class="mt-3 text-lg leading-relaxed text-mist">{f.bio[2]}</p>
          <p class="mt-4 font-semibold">{f.name}, <span class="font-normal text-mist">{f.role}</span></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Questions, then back to the form -->
  <section class="section on-light bg-paper text-ink" aria-labelledby="qs-h">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_2fr] lg:gap-16">
      <h2 id="qs-h" class="h2">Questions</h2>
      <div>
        <dl class="grid gap-8 sm:grid-cols-2">
          {
            p.faq.map((item) => (
              <div class="border-t-2 border-ink pt-4">
                <dt class="text-xl font-bold">{item.q}</dt>
                <dd class="mt-2 text-base leading-relaxed text-slate">{item.a}</dd>
              </div>
            ))
          }
        </dl>
        <div class="mt-12 flex flex-col items-start gap-5 sm:flex-row sm:items-center sm:gap-8">
          <a
            href="#check"
            class="inline-flex items-center justify-center gap-3 rounded-full bg-ink px-6 py-4 text-base font-semibold leading-tight text-paper transition-transform duration-150 hover:-translate-y-0.5 sm:text-lg"
            data-event="scorecard_cta_click"
            data-location="check-bottom">{p.backToTop}</a
          >
          <a href="/" class="py-3 font-semibold underline underline-offset-4" data-event="learn_more_click" data-location="check-bottom">{p.learnMore}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
