---
import { report } from '../content/site';
const { email, page } = report;
---

<div class="grid items-start gap-6 lg:grid-cols-[5fr_7fr] lg:gap-8">
  <!-- The 3-line email -->
  <div class="rounded-3xl bg-chalk p-5 text-ink shadow-2xl shadow-black/40 sm:p-7">
    <p class="text-xs font-semibold uppercase tracking-widest text-slate">The email</p>
    <div class="mt-4 border-b border-paper-2 pb-4 text-sm">
      <p><span class="text-slate">From:</span> <span class="font-semibold">{email.from}</span></p>
      <p class="mt-1"><span class="text-slate">Subject:</span> <span class="font-semibold">{email.subject}</span></p>
    </div>
    <p class="mt-4">{email.greeting}</p>
    <ol class="mt-3 space-y-3">
      {
        email.lines.map((line, i) => (
          <li class="flex gap-3">
            <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-ink text-xs font-bold text-paper" aria-hidden="true">{i + 1}</span>
            <span class="leading-snug">{line}</span>
          </li>
        ))
      }
    </ol>
    <p class="mt-4 text-slate">{email.signoff}</p>
  </div>

  <!-- The one-page report -->
  <div class="rounded-3xl bg-paper p-5 text-ink shadow-2xl shadow-black/40 sm:p-7">
    <div class="flex flex-wrap items-baseline justify-between gap-2 border-b border-paper-2 pb-4">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-slate">The one-page report</p>
        <p class="mt-1 font-display text-xl font-bold">{page.title}: {page.period}</p>
      </div>
      <p class="text-sm text-slate">{page.business}</p>
    </div>

    <dl class="mt-5 grid grid-cols-2 gap-3">
      {
        page.metrics.map((m) => (
          <div class="rounded-2xl bg-chalk p-4">
            <dt class="text-xs font-medium text-slate sm:text-sm">{m.label}</dt>
            <dd class="mt-1">
              <span class="block font-display text-3xl font-bold tracking-tight">{m.value}</span>
              <span class="mt-1 block text-xs text-slate">{m.change}</span>
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 rounded-2xl bg-ink p-4 text-paper">
      <p class="text-xs font-medium text-mist sm:text-sm">{page.ai.label}</p>
      <p class="font-display text-3xl font-bold tracking-tight text-paper">{page.ai.value}</p>
      <p class="min-w-40 flex-1 text-sm text-mist">{page.ai.detail}</p>
    </div>

    <div class="mt-5 grid gap-5 sm:grid-cols-2">
      <div>
        <p class="text-sm font-bold">{page.builtLabel}</p>
        <ul class="mt-2 space-y-1.5 text-sm">
          {
            page.built.map((b) => (
              <li>
                <span class="font-bold">{b.value}</span> <span class="text-slate">{b.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="text-sm font-bold">{page.planLabel}</p>
        <ul class="mt-2 list-disc space-y-1.5 pl-4 text-sm text-slate">
          {page.plan.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </div>
  </div>
</div>
