---
import Layout from './Layout.astro';
import { legal } from '../content/site';

interface Props {
  title: string;
  description: string;
  heading: string;
}
const { title, description, heading } = Astro.props;
---

<Layout title={title} description={description}>
  <section class="section on-light bg-paper text-ink">
    <div class="wrap">
      <div class="legal mx-auto max-w-3xl">
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{heading}</h1>
        <p class="mt-4 text-sm">Last updated: {legal.lastUpdated}</p>
        <slot />
      </div>
    </div>
  </section>
</Layout>
